@model IEnumerable<InventarioLaEconomica.Models.MovimientoInventario>

@{
    ViewData["Title"] = "Movimientos de Inventario";
}

<h1>Movimientos de Inventario</h1>

<p>
    <a asp-action="Create">Nuevo movimiento</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Tipo</th>
            <th>Cantidad</th>
            <th>Fecha</th>
            <th>Descripción</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Producto?.Nombre</td>
                <td>@item.Tipo</td>
                <td>@item.Cantidad</td>
                <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.Descripcion</td>
            </tr>
        }
    </tbody>
</table>