@model InventarioLaEconomica.Models.Proveedor

@{
    ViewData["Title"] = "Editar proveedor";
}

<h1>Editar proveedor</h1>

<hr />

<form asp-action="Edit">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="RNC"></label>
        <input asp-for="RNC" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Telefono">Teléfono</label>
        <input asp-for="Telefono" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Direccion">Dirección</label>
        <input asp-for="Direccion" class="form-control" />
    </div>

    <div class="form-check mb-3">
        <input asp-for="Activo" class="form-check-input" />
        <label asp-for="Activo" class="form-check-label">Activo</label>
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar cambios
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>

</form>