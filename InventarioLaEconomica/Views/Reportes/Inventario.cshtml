@model IEnumerable<InventarioLaEconomica.Models.Producto>

@{
    ViewData["Title"] = "Reporte de Inventario";
}

<style>
    .reporte-header {
        margin-bottom: 25px;
    }

        .reporte-header h1 {
            margin-bottom: 5px;
        }

    .acciones-reporte {
        margin-bottom: 20px;
    }

    @@media print {
        .no-imprimir {
            display: none !important;
        }

        header,
        footer {
            display: none !important;
        }
    }
</style>

<div class="reporte-header">
    <h1>Reporte de Inventario</h1>
    <p>Supermercado La Económica</p>
    <p>
        Fecha:
        @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
    </p>
</div>

<div class="acciones-reporte no-imprimir">
    <button onclick="window.print()" class="btn btn-primary">
        Imprimir reporte
    </button>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary">
        Volver al Dashboard
    </a>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Código</th>
            <th>Producto</th>
            <th>Categoría</th>
            <th>Precio Compra</th>
            <th>Precio Venta</th>
            <th>Stock</th>
            <th>Estado</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Codigo</td>
                <td>@item.Nombre</td>
                <td>@item.Categoria?.Nombre</td>
                <td>RD$ @item.PrecioCompra.ToString("N2")</td>
                <td>RD$ @item.PrecioVenta.ToString("N2")</td>
                <td>@item.Stock</td>
                <td>
                    @if (item.Stock <= 5)
                    {
                        <span>Stock bajo</span>
                    }
                    else
                    {
                        <span>Disponible</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>