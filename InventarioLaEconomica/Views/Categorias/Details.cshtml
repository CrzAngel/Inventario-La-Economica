@model InventarioLaEconomica.Models.Categoria

@{
    ViewData["Title"] = "Detalles de categoría";
}

<h1>Detalles de categoría</h1>

<hr />

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Descripción</dt>
    <dd class="col-sm-9">@Model.Descripcion</dd>

    <dt class="col-sm-3">Activa</dt>
    <dd class="col-sm-9">
        @(Model.Activa ? "Sí" : "No")
    </dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
    Editar
</a>

<a asp-action="Index" class="btn btn-secondary">
    Volver
</a>